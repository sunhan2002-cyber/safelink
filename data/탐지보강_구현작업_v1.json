      ],
      "family_impersonation_targets": [
        {
          "id": "FM-4-1-001",
          "keyword": "엄마 나야",
          "pattern": "엄마\\s*(?:나야|나예요|나에요|인데)"
        },
        {
          "id": "FM-4-1-002",
          "keyword": "아빠 나야",
          "pattern": "아빠\\s*(?:나야|나예요|나에요|인데)"
        },
        {
          "id": "FM-4-1-003",
          "keyword": "나 딸이야",
          "pattern": "나\\s*딸\\s*(?:이야|이에요|이예요|인데)"
        },
        {
          "id": "FM-4-1-004",
          "keyword": "나 아들이야",
          "pattern": "나\\s*아들\\s*(?:이야|이에요|이예요|인데)"
        },
        {
          "id": "FM-4-1-006",
          "keyword": "언니 나야",
          "pattern": "언니\\s*(?:나야|나예요|나에요|인데)"
        },
        {
          "id": "FM-4-1-007",
          "keyword": "폰이 고장",
          "pattern": "(?:휴대|핸드)?폰\\s*(?:이|은|도)?\\s*고장"
        },
        {
          "id": "FM-4-1-011",
          "keyword": "새 번호로 저장",
          "pattern": "새\\s*번호\\s*(?:로|를)?\\s*(?:저장|연락)"
        },
        {
          "id": "FM-4-2-001",
          "keyword": "지금 통화가 안 돼",
          "pattern": "(?:통화|전화)\\s*(?:가|는|도)?\\s*(?:안\\s*(?:돼|되|됨)|못\\s*(?:해|하)|어려워)"
        },
        {
          "id": "FM-4-3-002",
          "keyword": "대신 송금",
          "pattern": "대신\\s*(?:좀\\s*)?(?:송금|입금|돈\\s*(?:좀\\s*)?(?:보내|부쳐))"
        },
        {
          "id": "FM-4-4-003",
          "keyword": "인증문자 보여줘",
          "pattern": "인증\\s*문자\\s*(?:좀\\s*)?(?:보여|알려|보내|찍어)"
        }
      ],
